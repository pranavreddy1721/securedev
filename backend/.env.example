# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/securedev
# In production, use MongoDB Atlas connection string instead

# JWT - generate unique random values; never commit real secrets
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# bcrypt
BCRYPT_SALT_ROUNDS=12

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
# 32 random bytes encoded as base64
GITHUB_TOKEN_ENC_KEY=replace-with-32-byte-base64-key

# Upload limits
MAX_UPLOAD_MB=25

# Semgrep
SEMGREP_RULESETS=p/javascript,p/nodejs,p/expressjs
SEMGREP_TIMEOUT_MS=120000
NPM_AUDIT_TIMEOUT_MS=60000
